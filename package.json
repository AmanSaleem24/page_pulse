{
  "name": "page-pulse",
  "version": "1.0.0",
  "description": "A URL auditing tool that inspects SEO metadata, performance, and content quality of any web page.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand --forceExit"
  },
  "keywords": [
    "seo",
    "audit",
    "url",
    "web"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.0.0",
    "express": "^4.18.2",
    "undici": "^6.6.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
